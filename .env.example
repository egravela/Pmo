# Copia questo file in `.env` e compila i valori. Le variabili hanno il prefisso PMO_.

# --- Applicazione ---------------------------------------------------------------------------
PMO_BASE_URL=http://localhost:8000          # URL pubblico (serve per i redirect OAuth e i link nel digest)
PMO_SECRET_KEY=                             # genera con: pmo gen-keys
PMO_ENCRYPTION_KEY=                         # chiave Fernet per i token Google (pmo gen-keys)
PMO_TIMEZONE=Europe/Rome
PMO_DEV_LOGIN=false                         # true solo in sviluppo: login con la sola email, senza Google
PMO_LOG_LEVEL=INFO

# --- Database -------------------------------------------------------------------------------
# SQLite per provare, PostgreSQL (anche Supabase) in produzione:
PMO_DATABASE_URL=sqlite:///data/pmo.sqlite
# PMO_DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@db.xxxxx.supabase.co:5432/postgres

# --- Google OAuth (vedi docs/setup-google.md) ------------------------------------------------
PMO_GOOGLE_CLIENT_ID=
PMO_GOOGLE_CLIENT_SECRET=
PMO_ALLOWED_DOMAINS=latraccia.it            # domini ammessi al login (separati da virgola)
PMO_ADMIN_EMAILS=egravela@latraccia.it      # amministratori (il primo utente che accede lo diventa comunque)
PMO_GMAIL_SEND_SCOPE=false                  # true per inviare il digest dalla casella collegata (richiede ricollegamento)

# --- Sincronizzazione -----------------------------------------------------------------------
PMO_SYNC_WINDOW_DAYS=120                    # finestra della prima importazione
PMO_SYNC_INTERVAL_MINUTES=30
PMO_MAX_MESSAGES_PER_RUN=300
PMO_EXTRACT_ATTACHMENTS=true                # legge il testo dei PDF/DOCX allegati (ordini, offerte)
PMO_INTERNAL_DOMAINS=latraccia.it

# --- Intelligenza artificiale ---------------------------------------------------------------
ANTHROPIC_API_KEY=                          # oppure PMO_ANTHROPIC_API_KEY
PMO_AI_ENABLED=true
PMO_CLAUDE_MODEL=claude-opus-5-5            # alternative più economiche: claude-sonnet-5-5, claude-haiku-5-5
PMO_CLAUDE_EFFORT=low
PMO_CLAUDE_FALLBACKS=true
PMO_LINK_CONFIDENCE_THRESHOLD=0.8
PMO_EVENT_CONFIDENCE_THRESHOLD=0.7

# --- Scheduler e digest ---------------------------------------------------------------------
PMO_SCHEDULER_ENABLED=false                 # true per sincronizzare periodicamente dentro il processo web
PMO_DIGEST_ENABLED=true
PMO_DIGEST_HOUR=8
PMO_DIGEST_MINUTE=0
PMO_DIGEST_RECIPIENTS=                      # vuoto = tutti gli utenti attivi con digest abilitato

# --- SMTP (alternativa all'invio del digest via Gmail) ---------------------------------------
PMO_SMTP_HOST=
PMO_SMTP_PORT=587
PMO_SMTP_USER=
PMO_SMTP_PASSWORD=
PMO_SMTP_FROM=
PMO_SMTP_STARTTLS=true
